<Window x:Class="OptiForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiForge"
        Height="560" Width="840"
        MinHeight="480" MinWidth="720"
        Background="#FF121418"
        Foreground="#FFE8EAED"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFE8EAED"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#FF2A2F3A"/>
      <Setter Property="Foreground" Value="#FFE8EAED"/>
      <Setter Property="BorderBrush" Value="#FF3D4450"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="12,6"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="OptiForge" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="RootPathText" FontSize="12" Opacity="0.7"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Opacity="0.8"/>
    </DockPanel>

    <TabControl Background="Transparent" BorderThickness="0">
      <TabItem Header="Dashboard">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Background="#FF1C212B" CornerRadius="8" Padding="16" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="CPU" Opacity="0.7"/>
                <TextBlock x:Name="CpuText" Text="—" FontSize="28" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Background="#FF1C212B" CornerRadius="8" Padding="16" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="RAM" Opacity="0.7"/>
                <TextBlock x:Name="RamText" Text="—" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="RamDetailText" Opacity="0.6" FontSize="12"/>
              </StackPanel>
            </Border>
            <Border Background="#FF1C212B" CornerRadius="8" Padding="16">
              <StackPanel>
                <TextBlock Text="Disk" Opacity="0.7"/>
                <TextBlock x:Name="DiskText" Text="—" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="DiskDetailText" Opacity="0.6" FontSize="12"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock Grid.Row="1" TextWrapping="Wrap" Opacity="0.75"
                     Text="Monitor realtime. Dùng tab Clean để thu hồi dung lượng an toàn (dry-run mặc định)."/>
        </Grid>
      </TabItem>

      <TabItem Header="Clean">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Disk Clean" FontSize="16" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
            <CheckBox x:Name="DryRunCheck" Content="Dry-run (không xóa)"
                      IsChecked="True" VerticalAlignment="Center" Foreground="#FFE8EAED" Margin="0,0,16,0"/>
            <Button x:Name="ScanBtn" Content="Scan" Click="ScanClean_Click"/>
            <Button x:Name="CleanBtn" Content="Clean selected" Click="RunClean_Click"/>
          </StackPanel>
          <ListView x:Name="CleanList" Grid.Row="2"
                    Background="#FF1C212B" BorderBrush="#FF3D4450" Foreground="#FFE8EAED">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="36">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Category" DisplayMemberBinding="{Binding DisplayName}" Width="160"/>
                <GridViewColumn Header="Size" Width="90">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SizeText}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Files" DisplayMemberBinding="{Binding FileCount}" Width="60"/>
                <GridViewColumn Header="Note" DisplayMemberBinding="{Binding Note}" Width="280"/>
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock x:Name="CleanSummaryText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85"/>
        </Grid>
      </TabItem>

      <TabItem Header="RAM">
        <StackPanel Margin="8">
          <TextBlock Text="RAM Trim" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75"
                     Text="Thu nhỏ working set của process. Clear standby list cần Run as Administrator."/>
          <CheckBox x:Name="ClearStandbyCheck" Content="Clear standby list (cần admin)"
                    IsChecked="True" Margin="0,12,0,0" Foreground="#FFE8EAED"/>
          <TextBlock x:Name="AdminStatusText" Margin="0,8,0,0" Opacity="0.7"/>
          <Button x:Name="TrimRamBtn" Content="Trim RAM now" Click="TrimRam_Click"
                  Margin="0,12,0,0" HorizontalAlignment="Left"/>
          <TextBlock x:Name="RamTrimSummaryText" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.9"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="AI">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Local AI (llama.cpp)" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="AiStatusText" Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,8">
            <Button x:Name="StartAiBtn" Content="Start server" Click="StartAi_Click"/>
            <Button x:Name="StopAiBtn" Content="Stop" Click="StopAi_Click"/>
            <Button Content="Refresh" Click="RefreshAi_Click"/>
            <CheckBox x:Name="UseCacheCheck" Content="Use prompt cache" IsChecked="True"
                      Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FFE8EAED"/>
          </StackPanel>
          <Grid Grid.Row="3">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="1.2*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="AiPromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="#FF1C212B"
                     Foreground="#FFE8EAED" BorderBrush="#FF3D4450" Padding="8"
                     ToolTip="Nhập câu hỏi…"/>
            <Button Grid.Row="1" x:Name="SendAiBtn" Content="Send" Click="SendAi_Click"
                    Margin="0,8,0,8" HorizontalAlignment="Left"/>
            <TextBox x:Name="AiResponseBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="#FF1C212B"
                     Foreground="#FFE8EAED" BorderBrush="#FF3D4450" Padding="8"/>
          </Grid>
          <TextBlock x:Name="AiMetaText" Grid.Row="4" Opacity="0.7" FontSize="12"/>
        </Grid>
      </TabItem>

      <TabItem Header="Tips">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Playbooks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox x:Name="PlaybookList" Background="#FF1C212B" Foreground="#FFE8EAED"
                     BorderBrush="#FF3D4450" DisplayMemberPath="Title"
                     SelectionChanged="PlaybookList_SelectionChanged"/>
          </DockPanel>
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock x:Name="PlaybookTitleText" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="PlaybookStepsText" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.9"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <StackPanel Margin="8">
          <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="SettingsPathText" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"/>
          <TextBlock x:Name="VersionText" Margin="0,4,0,0" Opacity="0.7"/>
          <Button Content="Save settings" Click="SaveSettings_Click" Margin="0,12,0,0" HorizontalAlignment="Left"/>
          <Button Content="Check updates" Click="CheckUpdates_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
          <TextBlock x:Name="UpdateText" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.8"/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
