<Window x:Class="OptiForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiForge 3.0"
        Height="720" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource BrushAppBg}"
        Foreground="{StaticResource BrushText}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="Height" Value="0"/>
      <Setter Property="Width" Value="0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,14,10,12">
        <StackPanel DockPanel.Dock="Top" Margin="4,0,4,12">
          <TextBlock Text="OptiForge" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="RootPathText" FontSize="10" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ResourceAdviceText" FontSize="10" Foreground="{StaticResource BrushMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button Content="+ New chat" Style="{StaticResource NavButton}" Click="NewChat_Click"
                  Background="#FF1E3A40" FontWeight="SemiBold"/>
          <TextBox x:Name="ConvSearchBox" Margin="6,8,6,4" Padding="8,6"
                   Background="{StaticResource BrushElevated}" Foreground="{StaticResource BrushText}"
                   BorderBrush="{StaticResource BrushBorder}"
                   TextChanged="ConvSearchBox_TextChanged" ToolTip="Search conversations"/>
          <UniformGrid Columns="3" Margin="4,4,4,0">
            <Button Content="Rename" Click="RenameChat_Click" Margin="2" Padding="6,4" FontSize="11"
                    ToolTip="Doi ten chat dang chon (hoac F2)"/>
            <Button Content="Delete" Click="DeleteChat_Click" Margin="2" Padding="6,4" FontSize="11"
                    ToolTip="Xoa chat dang chon"/>
            <Button Content="Pin" Click="PinChat_Click" Margin="2" Padding="6,4" FontSize="11"
                    ToolTip="Ghim / bo ghim chat"/>
          </UniformGrid>
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="WORKSPACE" FontSize="10" Foreground="{StaticResource BrushMuted}" Margin="10,4,0,4"/>
            <Button Content="Chat" Style="{StaticResource NavButton}" Tag="AI" Click="Nav_Click"/>
            <Button Content="Agent" Style="{StaticResource NavButton}" Tag="Agent" Click="Nav_Click"/>
            <Button Content="Projects folder" Style="{StaticResource NavButton}" Click="AgentOpenProjects_Click"/>
            <TextBlock Text="SYSTEM" FontSize="10" Foreground="{StaticResource BrushMuted}" Margin="10,12,0,4"/>
            <Button Content="Monitor" Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click"/>
            <Button Content="Clean" Style="{StaticResource NavButton}" Tag="Clean" Click="Nav_Click"/>
            <Button Content="RAM" Style="{StaticResource NavButton}" Tag="RAM" Click="Nav_Click"/>
            <Button Content="Network" Style="{StaticResource NavButton}" Tag="Network" Click="Nav_Click"/>
            <Button Content="Startup" Style="{StaticResource NavButton}" Tag="Startup" Click="Nav_Click"/>
            <TextBlock Text="MORE" FontSize="10" Foreground="{StaticResource BrushMuted}" Margin="10,12,0,4"/>
            <Button Content="Quota Saver" Style="{StaticResource NavButton}" Tag="Quota" Click="Nav_Click"/>
            <Button Content="Tips" Style="{StaticResource NavButton}" Tag="Tips" Click="Nav_Click"/>
            <Button Content="Settings" Style="{StaticResource NavButton}" Tag="Settings" Click="Nav_Click"/>
          </StackPanel>
        </ScrollViewer>

        <ListBox x:Name="ConvList" Margin="0,4,0,0"
                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushText}"
                 DisplayMemberPath="ListLabel" SelectionChanged="ConvList_SelectionChanged"
                 MouseDoubleClick="ConvList_MouseDoubleClick"
                 PreviewKeyDown="ConvList_PreviewKeyDown">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Rename (F2)" Click="RenameChat_Click"/>
              <MenuItem Header="Pin / Unpin" Click="PinChat_Click"/>
              <Separator/>
              <MenuItem Header="Delete" Click="DeleteChat_Click"/>
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Main -->
    <DockPanel Grid.Column="1" Margin="16,12,16,12">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox x:Name="ChatTitleBox" Width="280" FontSize="16" FontWeight="SemiBold"
                   Background="Transparent" Foreground="{StaticResource BrushText}"
                   BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushBorder}"
                   Padding="0,2" LostFocus="ChatTitleBox_LostFocus" KeyDown="ChatTitleBox_KeyDown"
                   ToolTip="Sua ten chat roi Enter / click ra ngoai de luu"/>
          <Border Margin="12,0,0,0" CornerRadius="4" Padding="8,3" Background="{StaticResource BrushElevated}">
            <TextBlock x:Name="BackendBadgeText" Text="Backend" FontSize="11" Foreground="{StaticResource BrushMuted}"/>
          </Border>
          <Button Content="Rename" Click="RenameChat_Click" Margin="10,0,0,0" Padding="10,4" FontSize="11"/>
          <Button Content="Delete" Click="DeleteChat_Click" Margin="0" Padding="10,4" FontSize="11"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Foreground="{StaticResource BrushMuted}"/>
      </DockPanel>

      <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
      <TabItem Header="Dashboard" Tag="Dashboard">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Background="#FF1C212B" CornerRadius="8" Padding="16" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="CPU" Opacity="0.7"/>
                <TextBlock x:Name="CpuText" Text="—" FontSize="28" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Background="#FF1C212B" CornerRadius="8" Padding="16" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="RAM" Opacity="0.7"/>
                <TextBlock x:Name="RamText" Text="—" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="RamDetailText" Opacity="0.6" FontSize="12"/>
              </StackPanel>
            </Border>
            <Border Background="#FF1C212B" CornerRadius="8" Padding="16">
              <StackPanel>
                <TextBlock Text="Disk" Opacity="0.7"/>
                <TextBlock x:Name="DiskText" Text="—" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="DiskDetailText" Opacity="0.6" FontSize="12"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <StackPanel Grid.Row="1">
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="Monitor realtime. Dùng tab Clean để thu hồi dung lượng an toàn (dry-run mặc định)."/>
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                       Text="Trước khi rút ổ: Settings → Safe eject (cleanup) để dừng AI, gỡ QoS OptiForge_*, tránh process orphan trên host."/>
            <Button Content="Safe eject (cleanup)" Click="SafeEject_Click"
                    Margin="0,10,0,0" HorizontalAlignment="Left"
                    ToolTip="Dừng llama từ ổ này + gỡ QoS + dọn temp. Không restore startup trừ khi bật trong Settings."/>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Clean" Tag="Clean">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Disk Clean" FontSize="16" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
            <CheckBox x:Name="DryRunCheck" Content="Dry-run (không xóa)"
                      IsChecked="True" VerticalAlignment="Center" Foreground="#FFE8EAED" Margin="0,0,16,0"/>
            <Button x:Name="ScanBtn" Content="Scan" Click="ScanClean_Click"/>
            <Button x:Name="CleanBtn" Content="Clean selected" Click="RunClean_Click"/>
          </StackPanel>
          <ListView x:Name="CleanList" Grid.Row="2"
                    Background="#FF1C212B" BorderBrush="#FF3D4450" Foreground="#FFE8EAED">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="36">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Category" DisplayMemberBinding="{Binding DisplayName}" Width="160"/>
                <GridViewColumn Header="Size" Width="90">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SizeText}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Files" DisplayMemberBinding="{Binding FileCount}" Width="60"/>
                <GridViewColumn Header="Note" DisplayMemberBinding="{Binding Note}" Width="280"/>
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock x:Name="CleanSummaryText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85"/>
        </Grid>
      </TabItem>

      <TabItem Header="RAM" Tag="RAM">
        <StackPanel Margin="8">
          <TextBlock Text="RAM Trim" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75"
                     Text="Thu nhỏ working set của process. Clear standby list cần Run as Administrator."/>
          <CheckBox x:Name="ClearStandbyCheck" Content="Clear standby list (cần admin)"
                    IsChecked="True" Margin="0,12,0,0" Foreground="#FFE8EAED"/>
          <TextBlock x:Name="AdminStatusText" Margin="0,8,0,0" Opacity="0.7"/>
          <Button x:Name="TrimRamBtn" Content="Trim RAM now" Click="TrimRam_Click"
                  Margin="0,12,0,0" HorizontalAlignment="Left"/>
          <TextBlock x:Name="RamTrimSummaryText" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.9"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="AI" Tag="AI">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel>
            <TextBlock Text="Local AI" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border x:Name="AiReadyBadge" DockPanel.Dock="Right" CornerRadius="4" Padding="8,3"
                    Background="#FF2A323E" VerticalAlignment="Center" Margin="8,0,0,0">
              <TextBlock x:Name="AiReadyBadgeText" Text="Offline" FontSize="11" Opacity="0.9"/>
            </Border>
          </DockPanel>

          <TextBlock x:Name="AiCapabilityText" Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                     FontSize="12" Opacity="0.75"/>
          <TextBlock x:Name="AiStatusText" Grid.Row="2" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.85"/>

          <StackPanel Grid.Row="3" Margin="0,8,0,6">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SetupAiBtn" Content="Download AI" Click="SetupAi_Click"
                      ToolTip="Tải llama-server + GGUF ~2GB vào ổ portable (cần mạng)"/>
              <Button x:Name="StartAiBtn" Content="Start" Click="StartAi_Click"/>
              <Button x:Name="StopAiBtn" Content="Stop" Click="StopAi_Click"/>
              <Button Content="Refresh" Click="RefreshAi_Click"/>
              <CheckBox x:Name="UseCacheCheck" Content="Cache" IsChecked="True"
                        Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFE8EAED"
                        ToolTip="Lưu câu trả lời cho cùng prompt+mode"/>
              <CheckBox x:Name="MultiTurnCheck" Content="Hội thoại" IsChecked="True"
                        Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFE8EAED"
                        ToolTip="Gửi vài lượt trước để AI nhớ ngữ cảnh ngắn"/>
            </StackPanel>
            <ProgressBar x:Name="AiSetupProgress" Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
            <TextBlock x:Name="AiSetupDetail" Margin="0,4,0,0" Opacity="0.7" FontSize="12"/>

            <DockPanel Margin="0,10,0,0">
              <TextBlock Text="Chế độ" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,8,0"/>
              <ComboBox x:Name="AiModeCombo" Width="160" DisplayMemberPath="Title"
                        SelectionChanged="AiModeCombo_SelectionChanged"
                        Background="#FF1C212B" Foreground="#FFE8EAED" BorderBrush="#FF3D4450"/>
              <TextBlock x:Name="AiModeHintText" Margin="12,0,0,0" VerticalAlignment="Center"
                         Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
            </DockPanel>
            <WrapPanel x:Name="AiQuickPanel" Margin="0,8,0,0"/>
          </StackPanel>

          <TextBox x:Name="AiChatBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Background="#FF161A22" Foreground="#FFE8EAED" BorderBrush="#FF3D4450"
                   Padding="10" FontSize="13"/>

          <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AiPromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="56" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                     Background="#FF1C212B" Foreground="#FFE8EAED" BorderBrush="#FF3D4450"
                     Padding="8" PreviewKeyDown="AiPromptBox_PreviewKeyDown"/>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
              <Button x:Name="SendAiBtn" Content="Gửi" Click="SendAi_Click"
                      Margin="0,0,0,6" MinWidth="88"
                      ToolTip="Ctrl+Enter — stream trả lời"/>
              <Button Content="Cloud brief" Click="CopyCloudBrief_Click" MinWidth="88" Margin="0,0,0,6"
                      ToolTip="Copy prompt ngắn để paste ChatGPT/Gemini/Claude (tiết kiệm quota)"/>
              <Button Content="Xóa chat" Click="ClearAiChat_Click" MinWidth="88" Margin="0,0,0,6"/>
              <Button Content="Copy" Click="CopyAi_Click" MinWidth="88"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="AiMetaText" Grid.Row="6" Margin="0,6,0,0" Opacity="0.7" FontSize="12"/>
        </Grid>
      </TabItem>

      <TabItem Header="Agent" Tag="Agent">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Local Agent" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                     Text="Tao project tu chat (template-first, sandbox trong Projects/). Khong bang Cursor Agent — nhung dung local + co the noi LM Studio."/>

          <StackPanel Grid.Row="2" Margin="0,10,0,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Backend" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8"/>
              <ComboBox x:Name="AgentBackendCombo" Width="140" Margin="0,0,12,0"
                        SelectionChanged="AgentBackendCombo_SelectionChanged">
                <ComboBoxItem Content="Builtin (3B)" Tag="builtin" IsSelected="True"/>
                <ComboBoxItem Content="LM Studio" Tag="lmstudio"/>
              </ComboBox>
              <TextBox x:Name="LmStudioUrlBox" Width="220" Text="http://127.0.0.1:1234/v1"
                       Background="#FF1C212B" Foreground="#FFE8EAED" BorderBrush="#FF3D4450" Padding="6" Margin="0,0,8,0"/>
              <Button Content="Probe" Click="AgentProbe_Click"/>
            </StackPanel>
            <TextBlock x:Name="AgentBackendStatusText" Margin="0,6,0,0" Opacity="0.85" FontSize="12" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="Template" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8"/>
              <ComboBox x:Name="AgentTemplateCombo" Width="160" Margin="0,0,12,0">
                <ComboBoxItem Content="Auto" Tag="auto" IsSelected="True"/>
                <ComboBoxItem Content="HTML static" Tag="html-static"/>
                <ComboBoxItem Content="C# console" Tag="csharp-console"/>
                <ComboBoxItem Content="Python CLI" Tag="python-cli"/>
                <ComboBoxItem Content="Node mini" Tag="nodejs-mini"/>
              </ComboBox>
              <CheckBox x:Name="AgentDryRunCheck" Content="Dry-run" IsChecked="True"
                        Foreground="#FFE8EAED" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button Content="Plan" Click="AgentPlan_Click"/>
              <Button Content="Create project" Click="AgentCreate_Click"/>
              <Button Content="Open Projects" Click="AgentOpenProjects_Click"/>
            </StackPanel>
            <TextBox x:Name="AgentPromptBox" Margin="0,10,0,0" MinHeight="64" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#FF1C212B" Foreground="#FFE8EAED" BorderBrush="#FF3D4450" Padding="8"
                     Text="Tao trang HTML portfolio don gian cho Freelancer, co CSS dep, 1 trang."/>
          </StackPanel>

          <TextBox x:Name="AgentLogBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Background="#FF161A22" Foreground="#FFE8EAED" BorderBrush="#FF3D4450" Padding="10"/>
          <TextBlock x:Name="AgentMetaText" Grid.Row="4" Margin="0,8,0,0" Opacity="0.75" FontSize="12" TextWrapping="Wrap"/>
        </Grid>
      </TabItem>

      <TabItem Header="Quota" Tag="Quota">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">
            <TextBlock Text="Free-tier Saver" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"
                       Text="Local 3B khong bang Claude/GPT — nhung dung dung de keo dai free tier: viec de o day, cloud chi polish 1 lan."/>
            <TextBlock x:Name="QuotaStatsText" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>

            <TextBlock Text="1) Draft local → 2) Copy cloud brief → 3) Mo site → paste" Margin="0,16,0,8" Opacity="0.9"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Refresh stats" Click="QuotaRefresh_Click"/>
              <Button Content="Copy cloud brief" Click="CopyCloudBrief_Click"
                      ToolTip="Can co chat/draft o tab AI truoc"/>
              <Button Content="Copy batch template" Click="CopyBatchTemplate_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Open ChatGPT" Click="OpenChatGpt_Click"/>
              <Button Content="Open Gemini" Click="OpenGemini_Click"/>
              <Button Content="Open Claude" Click="OpenClaude_Click"/>
              <Button Content="Open Perplexity" Click="OpenPerplexity_Click"/>
            </StackPanel>

            <TextBlock Text="Tips keo dai quota" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <TextBlock x:Name="QuotaTipsText" TextWrapping="Wrap" Opacity="0.9" LineHeight="20"/>

            <TextBox x:Name="QuotaBatchBox" Margin="0,16,0,0" MinHeight="90" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#FF1C212B" Foreground="#FFE8EAED" BorderBrush="#FF3D4450" Padding="8"
                     Text="Viec 1: ...&#x0a;Viec 2: ...&#x0a;Viec 3: ..."/>
            <TextBlock Margin="0,6,0,0" Opacity="0.65" FontSize="12"
                       Text="Batch template: moi dong = 1 viec → Copy batch → 1 tin nhan cloud thay vi nhieu lan."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Network" Tag="Network">
        <StackPanel Margin="8">
          <TextBlock Text="Network throttle (Windows QoS)" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75"
                     Text="Giới hạn KB/s theo process (vd. chrome.exe). Cần Administrator. Không dùng WinDivert."/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBox x:Name="NetProcessBox" Width="160" Text="chrome.exe" Margin="0,0,8,0"
                     Background="#FF1C212B" Foreground="#FFE8EAED" BorderBrush="#FF3D4450" Padding="6"/>
            <TextBox x:Name="NetKbpsBox" Width="80" Text="500" Margin="0,0,8,0"
                     Background="#FF1C212B" Foreground="#FFE8EAED" BorderBrush="#FF3D4450" Padding="6"
                     ToolTip="KB/s (0 = gỡ limit)"/>
            <Button Content="Apply" Click="NetApply_Click"/>
            <Button Content="Remove limit" Click="NetRemove_Click"/>
            <Button Content="Remove ALL OptiForge QoS" Click="NetRemoveAll_Click"
                    ToolTip="Gỡ mọi policy OptiForge_* trên host (nên admin)"/>
          </StackPanel>
          <TextBlock x:Name="NetStatusText" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Startup" Tag="Startup">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Startup (debloat nhẹ)" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Margin="0,6,0,8" TextWrapping="Wrap" Opacity="0.75"
                     Text="Chỉ HKCU Run — tắt/bật có backup. Không xóa registry lung tung."/>
          <ListView x:Name="StartupList" Grid.Row="2" Background="#FF1C212B" BorderBrush="#FF3D4450" Foreground="#FFE8EAED">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="On" Width="40" DisplayMemberBinding="{Binding Enabled}"/>
                <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Command" Width="420" DisplayMemberBinding="{Binding Command}"/>
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="StartupDryRunCheck" Content="Dry-run" IsChecked="True"
                      Foreground="#FFE8EAED" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Refresh" Click="StartupRefresh_Click"/>
            <Button Content="Disable selected" Click="StartupDisable_Click"/>
            <Button Content="Enable selected" Click="StartupEnable_Click"/>
            <Button Content="Restore all" Click="StartupRestoreAll_Click"
                    ToolTip="Bật lại mọi startup đã tắt qua OptiForge và xóa key backup rỗng"/>
            <TextBlock x:Name="StartupStatusText" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.85"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Tips" Tag="Tips">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Playbooks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox x:Name="PlaybookList" Background="#FF1C212B" Foreground="#FFE8EAED"
                     BorderBrush="#FF3D4450" DisplayMemberPath="Title"
                     SelectionChanged="PlaybookList_SelectionChanged"/>
          </DockPanel>
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock x:Name="PlaybookTitleText" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="PlaybookStepsText" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.9"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Settings" Tag="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">
            <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="SettingsPathText" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText" Margin="0,4,0,0" Opacity="0.7"/>

            <TextBlock Text="Resource profile" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <ComboBox x:Name="ResourceProfileCombo" Width="180" Margin="0,8,0,0" HorizontalAlignment="Left">
              <ComboBoxItem Content="Balanced" IsSelected="True"/>
              <ComboBoxItem Content="LowMemory"/>
              <ComboBoxItem Content="Performance"/>
              <ComboBoxItem Content="Manual"/>
            </ComboBox>
            <TextBlock x:Name="ResourceProfileHintText" Margin="0,6,0,0" Opacity="0.75" FontSize="12" TextWrapping="Wrap"
                       Text="LowMemory giam context/maxTokens khi RAM thap. Performance chi khi con nhieu RAM trong."/>

            <TextBlock Text="Host impact (portable drive)" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                       Text="Khi rút ổ: process/QoS/registry trên PC host có thể còn lại. Auto-cleanup khi đóng app mặc định bật."/>
            <CheckBox x:Name="AutoCleanupCheck" Content="Auto cleanup on exit (stop llama + remove OptiForge QoS)"
                      IsChecked="True" Margin="0,10,0,0" Foreground="#FFE8EAED"/>
            <CheckBox x:Name="RestoreStartupsCheck" Content="Also restore disabled startups on exit"
                      IsChecked="False" Margin="0,6,0,0" Foreground="#FFE8EAED"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Scan host impact" Click="ScanHostImpact_Click"/>
              <Button Content="Safe eject (cleanup)" Click="SafeEject_Click"/>
            </StackPanel>
            <TextBlock x:Name="HostImpactText" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.85"/>

            <Button Content="Save settings" Click="SaveSettings_Click" Margin="0,16,0,0" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Check updates" Click="CheckUpdates_Click"/>
              <Button Content="Download + apply update" Click="ApplyUpdate_Click"
                      ToolTip="Tải OptiForge-win-*.zip từ GitHub Releases rồi restart"/>
            </StackPanel>
            <TextBlock x:Name="UpdateText" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.8"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    </DockPanel>
  </Grid>
</Window>
