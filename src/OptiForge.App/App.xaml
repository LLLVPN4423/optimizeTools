<Application x:Class="OptiForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="BgApp">#FF101114</Color>
    <Color x:Key="BgSidebar">#FF17191E</Color>
    <Color x:Key="BgElevated">#FF1D2027</Color>
    <Color x:Key="TextPrimary">#FFF2F3F5</Color>
    <Color x:Key="TextSecondary">#FFA5ABB6</Color>
    <Color x:Key="BorderSubtle">#FF30343D</Color>
    <Color x:Key="Accent">#FF2BB7C9</Color>
    <SolidColorBrush x:Key="BrushAppBg" Color="{StaticResource BgApp}"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource BgSidebar}"/>
    <SolidColorBrush x:Key="BrushElevated" Color="{StaticResource BgElevated}"/>
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderSubtle}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource Accent}"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF22252C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#FF2A2F3A"/>
      <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
    </Style>
  </Application.Resources>
</Application>
